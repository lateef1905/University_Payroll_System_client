# Where the Vite dev server proxies /api (the Django server). Default: http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000

# Only for builds served from a different origin than the API (requires CORS on the server).
# Leave empty to call /api on the same origin (recommended: serve both behind one reverse proxy).
VITE_API_URL=

# Address the Contact support page sends to (opens the user's mail app).
VITE_SUPPORT_EMAIL=payroll.support@ui.test
